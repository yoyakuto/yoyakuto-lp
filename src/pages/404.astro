---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ページが見つかりません" noindex>
  <main class="not-found">
    <p class="code">404</p>
    <h1>ページが見つかりません</h1>
    <p class="lead">この時間には予定がないようです。URL をお確かめください。</p>
    <a href="/">トップへ戻る</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    padding: 120px 32px 140px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .code {
    margin: 0;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--color-free-soft);
    color: var(--color-free);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  h1 {
    margin: 0;
    font-weight: 700;
    font-size: 30px;
  }
  .lead {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-sub);
  }
  a {
    margin-top: 8px;
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .not-found {
      padding: 96px 16px 112px;
    }
    h1 {
      font-size: 24px;
    }
  }
</style>
