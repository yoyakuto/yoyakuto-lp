---
import Ornament from './Ornament.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---
<div class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  <Ornament />
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-en);
    font-size: 14px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  h2 {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 34px;
    line-height: 1.6;
    letter-spacing: 0.14em;
  }
  .lead {
    margin: 8px 0 0;
    max-width: 640px;
    font-size: 15px;
    line-height: 2;
    color: var(--color-text-sub);
  }
  @media (max-width: 760px) {
    h2 {
      font-size: 26px;
      letter-spacing: 0.1em;
    }
    .lead {
      font-size: 14px;
      text-align: left;
    }
  }
</style>
