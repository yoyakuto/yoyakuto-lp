---
interface Props {
  tone?: 'default' | 'ink';
}

const { tone = 'default' } = Astro.props;
---
<div class:list={['ornament', tone]} aria-hidden="true">
  <span class="line"></span>
  <svg width="8" height="8" viewBox="0 0 8 8"><path d="M4 0 8 4 4 8 0 4Z"></path></svg>
  <span class="line"></span>
</div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .line {
    width: 64px;
    height: 1px;
    background: var(--color-accent);
  }
  svg {
    fill: var(--color-accent);
  }
</style>
