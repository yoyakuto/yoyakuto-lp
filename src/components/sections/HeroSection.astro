---
import CtaButtons from '../CtaButtons.astro';
import Ornament from '../Ornament.astro';

const WEEKDAYS = ['月', '火', '水', '木', '金'];
const FIRST_DAY_OF_MONTH = 12;
const TIMES = ['10:00', '10:30', '11:00', '11:30', '13:00', '13:30'];
// 予約ページの見本。true が予約できる枠で、false はメンバーの誰かに予定がある枠
const SLOTS = [
  [true, false, true, true, false],
  [true, false, false, true, false],
  [false, true, false, true, true],
  [false, true, true, false, true],
  [true, false, true, false, true],
  [true, true, false, false, true],
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow">Scheduling for teams</p>
    <h1 id="hero-title">チームの空き時間を、<br />そのまま予約ページに。</h1>
    <Ornament />
    <p class="lead">
      Yoyakuto は Google カレンダーと連携し、メンバー全員の予定が空いている時間だけを予約枠として公開できる日程調整サービスです。予約ページの URL を送れば、日程を決めるためのメールのやり取りは要りません。
    </p>
    <CtaButtons />
  </div>

  <figure class="mock">
    <div class="mock-card" aria-hidden="true">
      <div class="mock-head">
        <span class="mock-title">打ち合わせのご予約</span>
        <span class="mock-meta">30 分 ・ 日本時間</span>
      </div>
      <div class="mock-grid">
        <span class="corner"></span>
        {WEEKDAYS.map((day, index) => (
          <span class="day">
            <span class="day-name">{day}</span>
            <span class="day-date">{FIRST_DAY_OF_MONTH + index}</span>
          </span>
        ))}
        {TIMES.map((time, row) => (
          <>
            <span class="time">{time}</span>
            {SLOTS[row].map((open) => (
              <span class:list={['slot', open ? 'open' : 'busy']}>{open ? time : ''}</span>
            ))}
          </>
        ))}
      </div>
    </div>
    <figcaption>予約ページのイメージ。メンバー全員が空いている枠だけが選べます。</figcaption>
  </figure>
</section>

<style>
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: 112px 32px 120px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 64px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .copy :global(.ornament) {
    justify-content: flex-start;
  }
  .copy :global(.cta) {
    justify-content: flex-start;
    margin-top: 12px;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-en);
    font-size: 15px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  h1 {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.65;
    letter-spacing: 0.1em;
  }
  .lead {
    margin: 0;
    max-width: 540px;
    font-size: 15px;
    line-height: 2.1;
    color: var(--color-text-sub);
  }

  .mock {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mock-card {
    padding: 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    outline: 1px solid var(--color-border-inner);
    outline-offset: -9px;
    box-shadow: 0 24px 48px -32px rgb(26 29 43 / 0.35);
  }
  .mock-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 4px 4px 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .mock-title {
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.08em;
  }
  .mock-meta {
    font-size: 12px;
    color: var(--color-text-sub);
  }
  .mock-grid {
    display: grid;
    grid-template-columns: 52px repeat(5, minmax(0, 1fr));
    gap: 6px;
    padding-top: 18px;
  }
  .day {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.3;
    padding-bottom: 6px;
  }
  .day-name {
    font-size: 11px;
    color: var(--color-text-sub);
  }
  .day-date {
    font-family: var(--font-en);
    font-size: 20px;
  }
  .time {
    font-family: var(--font-en);
    font-size: 14px;
    color: var(--color-text-sub);
    align-self: center;
  }
  .slot {
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-en);
    font-size: 13px;
  }
  .open {
    border: 1px solid var(--color-accent);
    color: var(--color-accent-text);
    background: #fbf8f2;
  }
  .busy {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-border-inner) 0 1px,
      transparent 1px 7px
    );
  }
  figcaption {
    font-size: 12px;
    color: var(--color-text-sub);
    text-align: center;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding: 72px 16px 88px;
      gap: 56px;
    }
    h1 {
      font-size: 32px;
    }
  }
  @media (max-width: 480px) {
    h1 {
      font-size: 26px;
    }
    .mock-card {
      padding: 18px 14px;
    }
    .mock-grid {
      grid-template-columns: 40px repeat(5, minmax(0, 1fr));
      gap: 4px;
    }
    .slot {
      font-size: 11px;
    }
  }
</style>
