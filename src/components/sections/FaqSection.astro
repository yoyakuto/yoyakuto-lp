---
import SectionHeading from '../SectionHeading.astro';

const FAQS = [
  {
    question: 'どのカレンダーと連携できますか？',
    answer: '現在は Google カレンダーに対応しています。空き枠の計算と、予約が入ったときの予定の作成に使います。',
  },
  {
    question: '予約する側もアカウントが必要ですか？',
    answer: '予約を確定するときに、Google アカウントでのログインをお願いしています。空き枠はログインしなくても確認できます。',
  },
  {
    question: '複数のメンバーで予約を受けられますか？',
    answer: 'はい。1 つの予約ページに複数のメンバーを登録できます。予約枠になるのは、登録したメンバー全員の予定が空いている時間です。',
  },
  {
    question: '同じ時間に予約が重なることはありますか？',
    answer: '同じ予約ページで、すでに予約が入っている時間には新しい予約を受け付けません。同時に申し込みがあった場合も、先に確定した 1 件だけが残ります。',
  },
  {
    question: '予約が入ると、どうなりますか？',
    answer: '予約ページを作ったメンバーの Google カレンダーに予定が入り、予約した方には確認メールが届きます。予約の内容は管理画面でも確認できます。',
  },
  {
    question: '予約の受付を一時的に止められますか？',
    answer: '予約ページを非公開にすると受付が止まります。もう一度公開したときは、同じ URL のまま受付を再開できます。',
  },
  {
    question: '料金はかかりますか？',
    answer: '料金プランは準備中です。決まりしだいこのページでお知らせします。',
  },
];
---
<section class="faq">
  <div class="inner">
    <SectionHeading id="faq" time="14:00" eyebrow="FAQ" title="よくある質問" />
    <div class="items">
      {FAQS.map((faq) => (
        <details class="item">
          <summary>
            <span class="question">{faq.question}</span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <p class="answer">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 112px 32px;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    align-items: start;
    gap: 48px;
  }
  .items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .item[open] {
    border-color: var(--color-free);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .question {
    font-weight: 500;
    font-size: 15px;
    line-height: 1.7;
  }
  .toggle {
    position: relative;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-free-soft);
  }
  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 11.5px;
    width: 10px;
    height: 1.5px;
    background: var(--color-free);
    transition: transform 0.2s ease;
  }
  .toggle::after {
    transform: rotate(90deg);
  }
  .item[open] .toggle::after {
    transform: rotate(0deg);
  }
  .answer {
    margin: 0;
    padding: 0 20px 20px;
    font-size: 14px;
    line-height: 1.95;
    color: var(--color-text-sub);
  }
  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
  }
  @media (max-width: 760px) {
    .faq {
      padding: 88px 16px;
    }
    summary {
      padding: 16px;
    }
    .answer {
      padding: 0 16px 18px;
    }
    .question {
      font-size: 14px;
    }
  }
</style>
