---
import SectionHeading from '../SectionHeading.astro';

const FAQS = [
  {
    question: 'どのカレンダーと連携できますか？',
    answer: '現在は Google カレンダーに対応しています。空き枠の計算と、予約が入ったときの予定の作成に使います。',
  },
  {
    question: '予約する側もアカウントが必要ですか？',
    answer: '予約を確定するときに、Google アカウントでのログインをお願いしています。空き枠はログインしなくても確認できます。',
  },
  {
    question: '複数のメンバーで予約を受けられますか？',
    answer: 'はい。1 つの予約ページに複数のメンバーを登録できます。予約枠になるのは、登録したメンバー全員の予定が空いている時間です。',
  },
  {
    question: '同じ時間に予約が重なることはありますか？',
    answer: '同じ予約ページで、すでに予約が入っている時間には新しい予約を受け付けません。同時に申し込みがあった場合も、先に確定した 1 件だけが残ります。',
  },
  {
    question: '予約が入ると、どうなりますか？',
    answer: '予約ページを作ったメンバーの Google カレンダーに予定が入り、予約した方には確認メールが届きます。予約の内容は管理画面でも確認できます。',
  },
  {
    question: '予約の受付を一時的に止められますか？',
    answer: '予約ページを非公開にすると受付が止まります。もう一度公開したときは、同じ URL のまま受付を再開できます。',
  },
  {
    question: '料金はかかりますか？',
    answer: '料金プランは準備中です。決まりしだいこのページでお知らせします。',
  },
];
---
<section class="faq" aria-labelledby="faq">
  <div class="inner">
    <SectionHeading id="faq" eyebrow="FAQ" title="よくある質問" />
    <div class="items">
      {FAQS.map((faq) => (
        <details class="item">
          <summary>
            <span class="mark" aria-hidden="true">Q.</span>
            <span class="question">{faq.question}</span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <p class="answer">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 128px 32px;
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }
  .inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .items {
    margin-top: 64px;
    border-top: 1px solid var(--color-border);
  }
  .item {
    border-bottom: 1px solid var(--color-border);
  }
  summary {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 26px 8px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .mark {
    font-family: var(--font-en);
    font-style: italic;
    font-size: 19px;
    color: var(--color-accent-text);
  }
  .question {
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0.06em;
  }
  .toggle {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 14px;
    height: 1px;
    background: var(--color-text-sub);
    transition: transform 0.3s ease;
  }
  .toggle::after {
    transform: rotate(90deg);
  }
  .item[open] .toggle::after {
    transform: rotate(0deg);
  }
  .answer {
    margin: 0;
    padding: 0 8px 28px 48px;
    font-size: 14px;
    line-height: 2.05;
    color: var(--color-text-sub);
  }
  @media (max-width: 760px) {
    .faq {
      padding: 96px 16px;
    }
    .items {
      margin-top: 48px;
    }
    .question {
      font-size: 15px;
    }
    .answer {
      padding-left: 8px;
    }
  }
</style>
