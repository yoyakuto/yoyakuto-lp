---
const STRENGTHS = [
  { value: 'URL 1 本', note: '予約ページは URL を送るだけで共有できる' },
  { value: '全員の空き', note: 'メンバー全員の予定を重ねて空き枠を出す' },
  { value: '自動で登録', note: '入った予約は Google カレンダーに予定として入る' },
  { value: '二重予約 0', note: '同じ枠への同時の申し込みを受け付けない' },
];
---
<section class="strengths" aria-label="Yoyakuto の特長">
  <ul>
    {STRENGTHS.map((item) => (
      <li>
        <span class="value">{item.value}</span>
        <span class="note">{item.note}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .strengths {
    padding: 0 32px;
    margin-top: -40px;
  }
  ul {
    position: relative;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 20px 20px 22px;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-free);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 12px 24px -20px rgb(21 32 51 / 0.4);
  }
  .value {
    font-weight: 700;
    font-size: 20px;
  }
  .note {
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-text-sub);
  }
  @media (max-width: 960px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .strengths {
      padding: 0 16px;
      margin-top: -32px;
    }
    li {
      padding: 16px 14px 16px 16px;
    }
    .value {
      font-size: 17px;
    }
    .note {
      font-size: 12px;
    }
  }
</style>
