---
import SectionHeading from '../SectionHeading.astro';

// アイコンは 24px 四方の線画。path の d だけを持たせ、線の太さや色は CSS でそろえる
const FEATURES = [
  {
    icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4',
    title: 'Google カレンダーから空き枠を出す',
    body: '登録したメンバーの Google カレンダーを読み取り、予定が入っていない時間を予約枠として表示します。予定を変えれば、予約ページの空き枠にもそのまま反映されます。',
  },
  {
    icon: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M16 11a3 3 0 1 0 0-6M18 20a6 6 0 0 0-3-5.2',
    title: 'チームで受け付ける予約ページ',
    body: '1 つの予約ページに複数のメンバーを登録できます。全員の予定が空いている時間だけを枠にするので、同席が必要な商談や面接の日程調整に向いています。',
  },
  {
    icon: 'M6 3h12v18H6zM9 8h6M9 12h6M9 16h3',
    title: '予約フォームを自由に組み立てる',
    body: '会社名や相談内容など、予約時に聞きたい項目を追加できます。テキスト、メールアドレス、電話番号、選択肢、チェックボックスに対応し、並び順も変えられます。',
  },
  {
    icon: 'M3 6h18v12H3zM3 7l9 6 9-6',
    title: '予約はカレンダーとメールに届く',
    body: '予約が確定すると、Google カレンダーに参加者付きの予定を作成し、予約した方には確認メールを送ります。フォームの回答も予定の説明欄に入ります。',
  },
  {
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
    title: '受付時間と枠の長さを決める',
    body: '受付を始める時刻と終える時刻、1 枠の長さを予約ページごとに設定できます。昼休みなど、予約を受けたくない時間帯も除外できます。',
  },
  {
    icon: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
    title: '公開の停止と URL の再発行',
    body: '受付を一時的に止めても、予約ページの URL は変わりません。URL を知られたくない相手に渡ってしまったときは、新しい URL に作り直せます。',
  },
];
---
<section class="features">
  <div class="inner">
    <SectionHeading
      id="features"
      time="09:00"
      eyebrow="Features"
      title="主な機能"
      lead="予約ページの公開から、予約の受付、カレンダーへの登録まで。日程調整に必要なことを一つにまとめています。"
    />
    <ul class="cards">
      {FEATURES.map((feature) => (
        <li class="card">
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24"><path d={feature.icon}></path></svg>
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features {
    padding: 120px 32px 112px;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .cards {
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    padding: 28px 26px 30px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--color-free-soft);
  }
  .icon svg {
    fill: none;
    stroke: var(--color-free);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  h3 {
    margin: 20px 0 10px;
    font-weight: 700;
    font-size: 17px;
    line-height: 1.6;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.95;
    color: var(--color-text-sub);
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .features {
      padding: 88px 16px;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 40px;
      gap: 12px;
    }
    .card {
      padding: 24px 20px;
    }
  }
</style>
