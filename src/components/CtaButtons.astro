---
import { SIGNUP_URL } from '../consts';

interface Props {
  secondaryHref?: string;
  secondaryLabel?: string;
  tone?: 'default' | 'ink';
}

const { secondaryHref = '#features', secondaryLabel = '機能を見る', tone = 'default' } = Astro.props;
---
<div class:list={['cta', tone]}>
  <a class="button primary" href={SIGNUP_URL}>無料で始める</a>
  <a class="button secondary" href={secondaryHref}>{secondaryLabel}</a>
</div>

<style>
  .cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 176px;
    min-height: 52px;
    padding: 0 28px;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-decoration: none;
    border: 1px solid var(--color-ink);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .primary {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .primary:hover {
    background: #2c3044;
    color: var(--color-on-ink);
  }
  .secondary {
    background: transparent;
    color: var(--color-text);
  }
  .secondary:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  .ink .primary {
    background: var(--color-on-ink);
    color: var(--color-ink);
    border-color: var(--color-on-ink);
  }
  .ink .primary:hover {
    background: #ffffff;
    color: var(--color-ink);
  }
  .ink .secondary {
    color: var(--color-on-ink);
    border-color: var(--color-ink-sub);
  }
  .ink .secondary:hover {
    background: #262a3b;
    color: var(--color-on-ink);
  }
</style>
